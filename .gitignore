# --- private hand-over material (research, build notes, personal answers) — never published
.private/

# --- higgsfield (AI image/video CLI) — never commit credentials, cache, or generated media
.higgsfield/
.higgsfield*

# --- build & deps
model-gateway/node_modules/
model-gateway/dist/
node_modules/
*.tsbuildinfo

# --- remotion (videos/): deps and render output. The finished media is committed
# under docs/assets/, the intermediate renders are not.
videos/node_modules/
videos/out/
videos/.remotion/

# --- installer artefacts
*.bak
setup-report.json
answers.json
answers-*.json
!setup/answers.example.json

# --- gateway runtime state (lives in ~/.config/model-gateway, but just in case)
gateway.log*
serve.log
serve.pid
sessions/

# --- OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
