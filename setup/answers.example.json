{
  "$comment": "node setup.mjs --answers answers.json \u2014 every key optional; omitted keys take the default. Keys: <provider>_api_key = the key itself, or 'skip' | 'env' (use the provider's env var) | 'keep' (saved key). DO NOT commit this file. 'providers' limits the walk-through to those names (or 'all').",
  "providers": [
    "deepseek",
    "kimi",
    "ollama"
  ],
  "claude_scope": "user",
  "codex_scope": "user",
  "project_dir": "/path/to/repo  (only for project/both scope)",
  "key_storage": "config",
  "deepseek_api_key": "sk-...",
  "deepseek_default_model": "deepseek-v4-flash",
  "kimi_api_key": "env",
  "kimi_default_model": "kimi-k2.7-code",
  "zai_api_key": "skip",
  "zai_coding_plan": false,
  "minimax_api_key": "skip",
  "openrouter_api_key": "skip",
  "opencode_api_key": "skip",
  "ollama-cloud_api_key": "skip",
  "ollama_base_url": "http://localhost:11434/v1",
  "ollama_enabled": true,
  "ollama_default_model": "qwen3-coder:30b",
  "vllm_base_url": "http://localhost:8000/v1",
  "vllm_enabled": false,
  "protected_branches": "main,master,production,release",
  "allow_merge": true,
  "allow_push": true,
  "fallback_chain": "deepseek/deepseek-v4-flash,ollama/qwen3:8b",
  "skip_tests": false,
  "continue_after_preflight_fail": false,
  "github_flow": "skill",
  "harness_profiles": true,
  "harness_shell_rc": true,
  "extra_agents": "detected",
  "extra_scope": "user"
}
